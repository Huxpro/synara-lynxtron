[
  {
    "id": "thread-header-hairline",
    "role": "chat-surface header hairline (--app-surface-divider, 60%)",
    "edge": "bottom",
    "electron": {
      "selector": "header.chat-surface-divider"
    },
    "native": {
      "selector": ".ThreadPageHeader"
    }
  },
  {
    "id": "right-dock-seam",
    "role": "right dock seam (--app-surface-divider, 60%)",
    "edge": "left",
    "electron": {
      "selector": "[class~=\"border-[var(--app-surface-divider)]\"]"
    },
    "native": {
      "selector": ".ThreadRightDockHost"
    }
  },
  {
    "id": "right-dock-tab-header",
    "role": "chat-surface header hairline (--app-surface-divider, 60%)",
    "edge": "bottom",
    "electron": {
      "within": "[class~=\"border-[var(--app-surface-divider)]\"]",
      "selector": ".chat-surface-divider",
      "index": 0
    },
    "native": {
      "selector": ".ThreadRightDockTabHeader"
    }
  },
  {
    "id": "explorer-sidebar-seam",
    "role": "Explorer tree seam (border-border/65)",
    "edge": "right",
    "electron": {
      "selector": "aside[class~=\"border-border/65\"]"
    },
    "native": {
      "selector": ".ExplorerDockSidebar"
    }
  },
  {
    "id": "explorer-search-divider",
    "role": "Explorer search divider (border-border/65)",
    "edge": "bottom",
    "electron": {
      "selector": "div[class~=\"border-b\"][class~=\"border-border/65\"]"
    },
    "native": {
      "selector": ".ExplorerDockSearch"
    }
  },
  {
    "id": "explorer-preview-header",
    "role": "chat-surface header hairline (--app-surface-divider, 60%)",
    "edge": "bottom",
    "electron": {
      "within": "[class~=\"border-[var(--app-surface-divider)]\"]",
      "selector": ".chat-surface-divider",
      "index": 1
    },
    "native": {
      "selector": ".ExplorerDockPreviewHeader"
    }
  }
]
