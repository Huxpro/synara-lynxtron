{
  "name": "@synara/lynx",
  "version": "0.5.5-lynx.0",
  "private": true,
  "description": "A lightweight Lynxtron desktop client for Synara.",
  "author": "Synara contributors",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k --prefix none \"rspeedy dev --environment lynx\" \"dev-ready-rspeedy && rsbuild dev --environment desktop\"",
    "build": "node scripts/verify-lynxtron-runtime.mjs && rspeedy build --environment lynx && rsbuild build --environment desktop && node scripts/build-search-key-monitor.mjs && node scripts/stage-sharp-runtime.mjs && node scripts/stage-appsnap-helper.mjs",
    "start": "bun run build && lynxtron dist/desktop",
    "dev:web": "cross-env NODE_ENV=development concurrently -k --prefix node \"rspeedy dev --environment web\" \"dev-ready-rspeedy && rsbuild dev --environment web\"",
    "generate:icons": "node scripts/generate-lynx-icons.mjs",
    "generate:event-router": "node scripts/generate-event-router.mjs",
    "generate:diff-change-markers": "node scripts/generate-diff-change-markers.mjs",
    "generate:automations-state": "node scripts/generate-automations-state.mjs",
    "generate:hugeicons": "node scripts/generate-hugeicons.mjs",
    "build:web": "rspeedy build --environment web && rsbuild build --environment web",
    "build:probe:host-input:web": "cross-env SYNARA_HOST_INPUT_PROBE=1 rspeedy build --environment web && cross-env SYNARA_HOST_INPUT_PROBE=1 rsbuild build --environment web",
    "build:probe:host-input:native": "cross-env SYNARA_HOST_INPUT_PROBE=1 rspeedy build --environment lynx && cross-env SYNARA_HOST_INPUT_PROBE=1 rsbuild build --environment desktop && node scripts/stage-sharp-runtime.mjs",
    "stage:sharp-runtime": "node scripts/stage-sharp-runtime.mjs",
    "stage:appsnap-helper": "node scripts/stage-appsnap-helper.mjs",
    "start:web": "npm run build:web && npx serve dist/web",
    "test": "rstest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "node scripts/sync-tsconfig-paths.mjs --check && node scripts/generate-event-router.mjs --check && node scripts/generate-diff-change-markers.mjs --check && node scripts/generate-automations-state.mjs --check && node scripts/generate-hugeicons.mjs --check && node scripts/upstream-parallel-copies.mjs --check && tsc -p tsconfig.app.json && tsc -p src/main/desktop/tsconfig.json && tsc -p src/main/web/tsconfig.json && tsc -p tsconfig.tools.json",
    "typecheck:sync-paths": "node scripts/sync-tsconfig-paths.mjs",
    "pack": "bun run build && lynxtron-builder --publish never",
    "audit:reuse": "node scripts/reuse-audit.mjs",
    "audit:reuse:check": "node scripts/generate-event-router.mjs --check && node scripts/generate-diff-change-markers.mjs --check && node scripts/generate-automations-state.mjs --check && node scripts/generate-hugeicons.mjs --check && node scripts/upstream-parallel-copies.mjs --check && node scripts/reuse-audit.mjs --check",
    "audit:upstream-merge": "node scripts/upstream-merge-layer-report.mjs",
    "audit:upstream-footprint": "node scripts/upstream-footprint.mjs",
    "audit:upstream-footprint:check": "node scripts/upstream-footprint.mjs --check",
    "audit:component-lab": "bun scripts/component-lab-identity-audit.ts",
    "audit:component-lab:inventory": "bun scripts/component-lab-primitive-inventory.ts",
    "audit:style": "node scripts/style-audit.mjs",
    "audit:style:check": "node scripts/style-audit.mjs --check",
    "evidence:composer": "node scripts/composer-evidence.mjs",
    "evidence:composer:write": "node scripts/composer-evidence.mjs --allow-incomplete --write",
    "test:evidence:composer": "node --test scripts/composer-evidence.test.mjs",
    "evidence:perceptual": "node scripts/perceptual-evidence.mjs",
    "evidence:perceptual:write": "node scripts/perceptual-evidence.mjs --allow-incomplete --write",
    "test:evidence:perceptual": "node --test scripts/perceptual-evidence.test.mjs",
    "evidence:fidelity-loss": "node scripts/generate-fidelity-loss.mjs",
    "test:evidence:fidelity-loss": "node --test scripts/fidelity-loss.logic.test.mjs",
    "evidence:settings-continuation": "node scripts/settings-continuation-evidence.mjs",
    "test:evidence:settings-continuation": "node --test scripts/settings-continuation-evidence.test.mjs",
    "evidence:providers": "node scripts/providers-evidence.mjs",
    "test:evidence:providers": "node --test scripts/providers-evidence.test.mjs",
    "evidence:specimens": "node scripts/specimen-evidence.mjs",
    "evidence:specimens:incomplete": "node scripts/specimen-evidence.mjs --allow-incomplete",
    "test:evidence:specimens": "node --test scripts/specimen-evidence.test.mjs",
    "test:evidence:native-capture": "node --test scripts/native-perceptual-capture.test.mjs",
    "connection:preflight": "node scripts/connection-preflight.mjs",
    "test:connection-preflight": "node --test scripts/connection-preflight.test.mjs",
    "test:stage-sharp-runtime": "node --test scripts/stage-sharp-runtime.test.mjs"
  },
  "dependencies": {
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/cal-sans": "5.3.0",
    "@lynx-js/config-rsbuild-plugin": "0.2.4",
    "@lynx-js/css-serializer": "0.1.9",
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/lynx-ui": "^3.139.0",
    "@lynx-js/lynxtron": "0.0.28",
    "@lynx-js/lynxtron-builder": "0.0.28",
    "@lynx-js/lynxtron-dev-plugins": "0.0.28",
    "@lynx-js/preact-devtools": "5.0.1-20260827072047-5f77e12",
    "@lynx-js/react": "0.126.2",
    "@lynx-js/react-rsbuild-plugin": "0.20.3",
    "@lynx-js/rspeedy": "0.18.0",
    "@lynx-js/tailwind-preset": "^0.6.0",
    "@lynx-js/type-config": "4.2.0",
    "@lynx-js/types": "4.3.0",
    "@lynx-js/web-core": "0.26.2",
    "@lynx-js/web-elements": "0.12.12",
    "@lynx-js/websocket": "^0.0.4",
    "@rsbuild/core": "2.1.5",
    "@rsbuild/plugin-type-check": "1.5.0",
    "@rspack/core": "2.1.5",
    "@rstest/core": "0.11.4",
    "@synara/contracts": "workspace:*",
    "@synara/shared": "workspace:*",
    "@tabler/icons": "^3.44.0",
    "@tanstack/history": "^1.162.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.160.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@types/react": "^18.3.24",
    "@types/ws": "^8.18.1",
    "acorn": "^8.16.0",
    "background-only": "0.0.1",
    "compressing": "^1.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "decode-named-character-reference": "1.3.0",
    "diff": "9.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "6.1.4",
    "preact": "npm:@lynx-js/internal-preact@11.0.0-rc.1-20260903085447-f95471a",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^3.4.19",
    "tslib": "2.8.1",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "url-search-params-polyfill": "^8.2.5",
    "ws": "^8.21.1",
    "zustand": "^5.0.11"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
