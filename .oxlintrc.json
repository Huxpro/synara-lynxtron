{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "apps/lynx/spikes",
    ".p10-view",
    ".p10-view-native",
    "dist",
    "dist-electron",
    "node_modules",
    "bun.lock",
    "*.tsbuildinfo",
    "**/routeTree.gen.ts",
    ".synara-*"
  ],
  "plugins": ["eslint", "oxc", "react", "unicorn", "typescript"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react-in-jsx-scope": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off"
  },
  "overrides": [
    {
      // Lynx-owned source only. Lynx passes these names into every bundle with no
      // value, so a use here throws at runtime; go through `src/platform/*`.
      // Upstream-owned files are never edited and are not linted for this: the
      // Lynx build binds the names for `apps/web/src`
      // (apps/lynx/src/platform/browserEnvironment.lynx.ts).
      "files": ["apps/lynx/src/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "localStorage",
          "sessionStorage"
        ]
      }
    },
    {
      "files": ["apps/lynx/src/**/*.test.*"],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ]
}
